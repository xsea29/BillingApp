<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      The window background is the start-up screen before Android 12, and what sits under the
      first frame everywhere: white with the word "Monginis". The light status bar keeps the
      icons readable on the white.
    -->
    <style name="Theme.BillingApp" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:statusBarColor">@android:color/white</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
